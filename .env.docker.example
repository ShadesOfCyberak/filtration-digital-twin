# Docker Compose Environment Template

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# InfluxDB Configuration
INFLUXDB_PORT=8086
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=adminpassword123
INFLUXDB_INIT_ORG=filtration_org
INFLUXDB_INIT_BUCKET=filtration_bucket
INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-influxdb-admin-token

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001

# FastAPI Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=super-secret-jwt-signing-key-for-digital-twin-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

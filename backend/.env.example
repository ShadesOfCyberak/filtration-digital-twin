# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# InfluxDB Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-influxdb-admin-token
INFLUXDB_ORG=filtration_org
INFLUXDB_BUCKET=filtration_bucket

# MQTT Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=fastapi_digital_twin_backend
MQTT_TOPIC_PREFIX=filtration

# Security
JWT_SECRET_KEY=super-secret-jwt-signing-key-for-digital-twin-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
